	-- Function to teleport player to a specific position with priority support
	-- Handles sitting check and unsit before teleporting
	-- priority: TELEPORT_PRIORITY value (default: LOW)
	-- teleportName: Name identifier for the teleport (for debugging)
	local function teleportPlayerToPosition(targetPosition, priority, teleportName)
		-- Default to LOW priority if not specified
		priority = priority or TELEPORT_PRIORITY.LOW
		teleportName = teleportName or "Unnamed Teleport"

		-- Check if this teleport can proceed based on priority
		if not canTeleport(priority, teleportName) then
			local blockedBy = teleportManager.activeTeleportName or "unknown"
			local blockedByPriority = getPriorityName(teleportManager.currentPriority)
			print("[Teleport] Blocked: " .. teleportName .. " (priority: " .. getPriorityName(priority) .. ") by " .. blockedBy .. " (priority: " .. blockedByPriority .. ")")
			return false
		end

		local character = player.Character
		if not character then return false end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

		if not humanoidRootPart then return false end

		-- Start the teleport (set active priority)
		startTeleport(priority, teleportName)

		-- Check if player is sitting and make them unsit first
		if humanoid then
			if humanoid.SeatPart then
				-- Player is sitting, make them unsit
				humanoid.Sit = false
				-- Wait a brief moment for the unsit to take effect
				task.wait(0.1)
			end
		end

		-- Teleport using Vector3.new() for the position
		humanoidRootPart.CFrame = CFrame.new(Vector3.new(targetPosition.X, targetPosition.Y, targetPosition.Z))

		-- End the teleport (clear active priority)
		endTeleport()

		return true
	end

