			local function getRandomOrePosition()
				local ores = getAvailableOres()
				if #ores == 0 then return nil, nil end

				local randomOre = ores[math.random(1, #ores)]
				local primPart = randomOre:FindFirstChild("prim") or randomOre:FindFirstChildWhichIsA("BasePart")

				if primPart then
					return primPart.Position + Vector3.new(0, 3, 0), randomOre -- Offset to avoid clipping
				end

				return nil, nil
			end

			-- Unsit player if sitting
			local function unsitPlayer()
				local character = player.Character
				if not character then return end

				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.SeatPart then
					humanoid.Sit = false
					task.wait(0.1)
				end
			end

			-- Start the auto ore miner
			local function startAutoOreMiner()
				if autoOreMinerRunning then return end

				-- Save current position
				local character = player.Character
				if character then
					local hrp = character:FindFirstChild("HumanoidRootPart")
					if hrp then
						savedPosition = hrp.CFrame
					end
				end

				-- Enable MEDIUM priority
				if _G.WaydroidPriority then
					_G.WaydroidPriority:enablePriority(TELEPORT_PRIORITY.MEDIUM, "Auto-ore miner")
				end

				autoOreMinerRunning = true
				waitingForOre = false

				-- Velocity reset connection (keeps player from glitching)
				velocityConnection = RunService.RenderStepped:Connect(function()
					if not autoOreMinerRunning then return end

					local char = player.Character
					if char then
						local hrp = char:FindFirstChild("HumanoidRootPart")
						if hrp then
							hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						end
					end
				end)

				-- Main mining loop
				autoOreMinerConnection = RunService.RenderStepped:Connect(function()
					if not autoOreMinerRunning then return end

					-- Check if we have ores to mine
					local ores = getAvailableOres()
					if #ores == 0 then
						-- No ores available, temporarily disable priority and wait
						if not waitingForOre then
							waitingForOre = true
							if _G.WaydroidPriority then
								_G.WaydroidPriority:disablePriority()
							end
						end
						return
					else
						-- Ores available, re-enable priority if we were waiting
						if waitingForOre then
							waitingForOre = false
							if _G.WaydroidPriority then
								_G.WaydroidPriority:enablePriority(TELEPORT_PRIORITY.MEDIUM, "Auto-ore miner")
							end
						end
					end

					-- Get random ore position
					local targetPos, targetOre = getRandomOrePosition()
					if not targetPos then return end

					-- Unsit if sitting
					unsitPlayer()

					-- Teleport to ore
					local char = player.Character
					if char then
						local hrp = char:FindFirstChild("HumanoidRootPart")
						if hrp then
							hrp.CFrame = CFrame.new(targetPos)
						end
					end

					-- Fire remotes based on mode
					local isEfficient = efficientBool and efficientBool.Value

					if isEfficient then
						-- Efficient mode: only use Drill remote (70% drop rate)
						if drillRemote then
							drillRemote:FireServer(targetOre)
						end
					else
						-- Fast mode: use both remotes (50% drop rate)
						if drillRemote then
							drillRemote:FireServer(targetOre)
						end
						if mineRemote then
							mineRemote:FireServer(targetOre)
						end
					end
				end)
			end

			-- Stop the auto ore miner
			local function stopAutoOreMiner()
				if not autoOreMinerRunning then return end

				autoOreMinerRunning = false
				waitingForOre = false

				-- Disconnect the connections
				if autoOreMinerConnection then
					autoOreMinerConnection:Disconnect()
					autoOreMinerConnection = nil
				end

				if velocityConnection then
					velocityConnection:Disconnect()
					velocityConnection = nil
				end

				-- Disable priority
				if _G.WaydroidPriority then
					_G.WaydroidPriority:disablePriority()
				end

				-- Restore saved position
				if savedPosition then
					local character = player.Character
					if character then
						local hrp = character:FindFirstChild("HumanoidRootPart")
						if hrp then
							unsitPlayer()
							hrp.CFrame = savedPosition
						end
					end
					savedPosition = nil
				end
			end

			-- Connect the Autominer button (swaps ore selection)
			if autominerButton then
				updateAutominerButtonText()
				autominerButton.Activated:Connect(function()
					playClickSound()

					-- Cycle through: Purple -> Red -> Both -> Purple
					if purpleOreBool and purpleOreBool.Value then
						purpleOreBool.Value = false
						if redOreBool then redOreBool.Value = true end
					elseif redOreBool and redOreBool.Value then
						redOreBool.Value = false
						if bothOresBool then bothOresBool.Value = true end
					elseif bothOresBool and bothOresBool.Value then
						bothOresBool.Value = false
						if purpleOreBool then purpleOreBool.Value = true end
					else
						-- Default to purple if nothing is set
						if purpleOreBool then purpleOreBool.Value = true end
					end

					updateAutominerButtonText()
				end)
			end

			-- Connect the Enabled button
			if enabledButton then
				updateEnabledButtonText()
				enabledButton.Activated:Connect(function()
					playClickSound()

					if enabledBool then
						enabledBool.Value = not enabledBool.Value

						if enabledBool.Value then
							startAutoOreMiner()
						else
							stopAutoOreMiner()
						end

						updateEnabledButtonText()
					end
				end)
			end

			-- Connect the Miner state button (Efficient/Fast)
			if minerStateButton then
				updateMinerStateButtonText()
				minerStateButton.Activated:Connect(function()
					playClickSound()

					if efficientBool then
						efficientBool.Value = not efficientBool.Value
						updateMinerStateButtonText()
					end
				end)
			end

			-- Initialize button states
			updateAutominerButtonText()
			updateEnabledButtonText()
			updateMinerStateButtonText()
		end
	end

	print("Segment 2 initialized")
end)
