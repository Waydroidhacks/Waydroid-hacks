	-- Function to get value from TV TextLabel by title
	local function getTVValueByTitle(title)
		local success, result = pcall(function()
			local tvFolder = game.Workspace:FindFirstChild("Facility")
				and game.Workspace.Facility.Core:FindFirstChild("Buildings")
				and game.Workspace.Facility.Core.Buildings:FindFirstChild("ControlRoom")
				and game.Workspace.Facility.Core.Buildings.ControlRoom:FindFirstChild("Controls")
				and game.Workspace.Facility.Core.Buildings.ControlRoom.Controls:FindFirstChild("TV")

			if not tvFolder then return nil end

			-- Iterate through all children to find matching TV
			for _, child in ipairs(tvFolder:GetChildren()) do
				local screen = child:FindFirstChild("Screen")
				if screen then
					local surfaceGui = screen:FindFirstChild("SurfaceGui")
					if surfaceGui then
						local textLabel = surfaceGui:FindFirstChild("TextLabel")
						local valueLabel = surfaceGui:FindFirstChild("Value")
						if textLabel and valueLabel then
							-- Check if title matches (case-insensitive, ignoring extra spaces)
							local labelTitle = textLabel.Text:gsub("%s+", " "):match("^%s*(.-)%s*$")
							local cleanTitle = title:gsub("%s+", " "):match("^%s*(.-)%s*$")
							if labelTitle:lower() == cleanTitle:lower() then
								return valueLabel.Text
							end
						end
					end
				end
			end

			return nil
		end)

		if success then
			return result
		else
			return nil
		end
	end

