local function fireInstance(instance)
	local success, err = pcall(function()
		local className = instance.ClassName

		if className == "TouchTransmitter" then
			local part = instance.Parent
			if part and part:IsA("BasePart") then
				local char = player.Character
				if char then
					local humanoidPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
					if humanoidPart then
						firetouchinterest(part, humanoidPart, 0) -- Ignore unknown function, it appears to work in-game
						task.wait(0.1)
						firetouchinterest(part, humanoidPart, 1) -- Ignore unknown function, it appears to work in-game
					end
				end
			end
		elseif className == "ClickDetector" then
			fireclickdetector(instance) -- Ignore unknown function, it appears to work in-game
		elseif className == "ProximityPrompt" then
			fireproximityprompt(instance) -- Ignore unknown function, it appears to work in-game
		elseif className == "RemoteEvent" then
			instance:FireServer()
		elseif className == "RemoteFunction" then
			instance:InvokeServer()
		elseif className == "BindableEvent" then
			instance:Fire()
		elseif className == "BindableFunction" then
			local func = instance.OnInvoke
			if func then
				func()
			end
		end
	end)
	if not success then
		warn("Failed to fire:", err)
	end
end
