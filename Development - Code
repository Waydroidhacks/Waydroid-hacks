local GUI = Instance.new("ObjectValue",game:GetService("ReplicatedStorage"))
GUI.Name = "WaydroidGUI"
-- Thing to remember: GUI.Value is the screengui. So for example if you put GUI.Enabled = true you'll get error because its an objectvalue, GUI.Value.Enabled will work though
local player = game:GetService("Players").LocalPlayer
local playergui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui",math.huge)
local CoreGui = game:GetService("CoreGui")

-- Wait for the GUI with the tag "GUI_waydroid_loaded"
local guiFound = false
local childAddedConnection = nil

local function findTaggedGUI()
end

local function onGUIFound(child)
	if child ~= nil then
		print(child)
		guiFound = true
		print("GUI found, starting script")
		GUI.Value = child
		-- Stop listening for new GUIs since we found one
		if childAddedConnection then
			childAddedConnection:Disconnect()
			childAddedConnection = nil
		end
	else print(nil)
	end
end

-- Check if GUI already exists
local taggedGUI = findTaggedGUI()

if taggedGUI then
	onGUIFound(taggedGUI)
else
	-- Wait for the GUI to be added with a 10-second timeout per GUI
	childAddedConnection = playergui.ChildAdded:Connect(function(child)
		if guiFound then return end -- Already found one, ignore

		-- Start tracking this GUI for up to 10 seconds
		task.spawn(function()
			local startTime = tick()
			local timeout = 10

			while tick() - startTime < timeout and not guiFound do
				print("Tracking")
				if child:HasTag("GUI_waydroid_loaded") then
					onGUIFound(child)
					return
				end
				task.wait(0.1)
			end
			-- If we reach here, 10 seconds passed without finding the tag on this GUI
			-- This GUI is ignored
		end)
	end)
end
