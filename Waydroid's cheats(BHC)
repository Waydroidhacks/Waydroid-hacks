-- The code below is the script for the GUI, once it is found by the tracker, it will run this script
GUI.Changed:Once(function()
	print("Script is starting..")

	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")
	local screenGui = GUI.Value
	local container = screenGui:FindFirstChild("Container")
	local icon = screenGui:FindFirstChild("Icon")
	local sound = screenGui:FindFirstChild("GuiClick")
	local sectionSelect = container and container:FindFirstChild("SectionSelect")
	local actionsection = container and container:FindFirstChild("Actionsection")
	local closeButton = container and container:FindFirstChild("GUIname") and container.GUIname:FindFirstChild("Close button")
	local closeButtonInstance = closeButton and closeButton:FindFirstChild("TextButton")

	-- Store original sizes and positions
	local containerOriginalSize = container and container.Size or UDim2.new(0.609561741, 0, 0.808333337, 0)
	local containerOriginalPosition = container and container.Position or UDim2.new(0.499168813, 0, 0.5, 0)
	local iconOriginalPosition = icon and icon.Position or UDim2.new(0.492031872, 0, 0.185416669, 0)
	local isCollapsed = false
	local isAnimating = false
	local currentSelection = nil

	-- Track last positions for restoration
	local containerLastPosition = containerOriginalPosition
	local iconLastPosition = iconOriginalPosition

	-- Animation tween info
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

	-- ============================================
	-- 1. Play sound function
	-- ============================================
	local function playClickSound()
		if sound then
			sound:Stop()
			sound:Play()
		end
	end

	-- ============================================
	-- 2. Collapse/Open animations for Container and Icon
	-- ============================================
	local function getIconTextButton()
		if not icon then return nil end
		local waydroidIcon = icon:FindFirstChild("Waydroid icon")
		return waydroidIcon and waydroidIcon:FindFirstChild("TextButton")
	end

	local function collapseContainer()
		if isCollapsed or not container or isAnimating then return end
		isCollapsed = true
		isAnimating = true

		-- Save current positions before collapsing
		containerLastPosition = container.Position
		if icon then
			iconLastPosition = icon.Position
		end

		-- Play sound immediately
		playClickSound()

		-- Disable close button immediately to prevent double-clicks
		if closeButtonInstance then
			closeButtonInstance.Interactable = false
		end

		-- Collapse container to 0% size
		local collapseTween = TweenService:Create(container, tweenInfo, {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		})
		collapseTween:Play()
		collapseTween.Completed:Connect(function()
			-- Hide and disable container when fully collapsed
			container.Visible = false
			container.Interactable = false
			isAnimating = false
		end)

		-- Show icon when collapsed at its last position
		if icon then
			icon.Visible = true
			icon.Interactable = true
			icon.Size = UDim2.new(0, 0, 0, 0)
			icon.Position = iconLastPosition

			-- Disable icon button during animation
			local iconBtn = getIconTextButton()
			if iconBtn then
				iconBtn.Interactable = false
			end

			local iconTween = TweenService:Create(icon, tweenInfo, {
				Size = UDim2.new(0, 60, 0, 60)
			})
			iconTween:Play()
			iconTween.Completed:Connect(function()
				-- Enable icon button after animation completes
				if iconBtn then
					iconBtn.Interactable = true
				end
			end)
		end
	end

	local function openContainer()
		if not isCollapsed or not container or isAnimating then return end
		isCollapsed = false
		isAnimating = true

		-- Play sound immediately
		playClickSound()

		-- Disable icon button immediately to prevent double-clicks
		local iconBtn = getIconTextButton()
		if iconBtn then
			iconBtn.Interactable = false
		end

		-- Show and enable container before animating
		container.Visible = true
		container.Interactable = true

		-- Hide icon first
		if icon then
			local iconTween = TweenService:Create(icon, tweenInfo, {
				Size = UDim2.new(0, 0, 0, 0)
			})
			iconTween:Play()
			iconTween.Completed:Connect(function()
				icon.Visible = false
				icon.Interactable = false
				icon.Size = UDim2.new(0, 60, 0, 60)
			end)
		end

		-- Open container back to last saved position
		local openTween = TweenService:Create(container, tweenInfo, {
			Size = containerOriginalSize,
			Position = containerLastPosition
		})
		openTween:Play()
		openTween.Completed:Connect(function()
			-- Enable close button after animation completes
			if closeButtonInstance then
				closeButtonInstance.Interactable = true
			end
			isAnimating = false
		end)
	end

	-- Close button click handler
	if closeButtonInstance then
		closeButtonInstance.Activated:Connect(collapseContainer)
	end

	-- Icon TextButton click handler (inside "Waydroid icon" frame)
	if icon then
		local iconTextButton = icon and icon:FindFirstChild("TextButton")
		if iconTextButton then
			iconTextButton.Activated:Connect(openContainer)
		end
	end

	-- Keyboard F key handler
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.F then
			-- Same cooldown as clicking the icon - check isAnimating flag
			if isAnimating then return end
			if isCollapsed then
				openContainer()
			else
				collapseContainer()
			end
		end
	end)

	-- ============================================
	-- 3. Selection switching with UIStroke highlighting
	-- ============================================
	local function showActionSection(selectionName)
		if not actionsection then return end

		-- Hide all action sections first and make them not interactable
		for _, child in actionsection:GetChildren() do
			if child:IsA("Frame") and child.Name ~= "UIStroke" then
				child.Visible = false
				child.Interactable = false
			end
		end

		-- Show the selected section
		local targetSection = actionsection:FindFirstChild(selectionName)
		if targetSection then
			targetSection.Visible = true
			targetSection.Interactable = true
		else
			-- Show default (No selection) if section not found
			local defaultSection = actionsection:FindFirstChild("No selection")
			if defaultSection then
				defaultSection.Visible = true
				defaultSection.Interactable = true
			end
		end
	end

	local function showDefaultTaggedSection()
		if not actionsection then return end

		-- Find the frame with tag "Default"
		for _, child in actionsection:GetChildren() do
			if child:IsA("Frame") and child:HasTag("Default") then
				-- Hide all other sections and make them not interactable
				for _, other in actionsection:GetChildren() do
					if other:IsA("Frame") and other.Name ~= "UIStroke" then
						other.Visible = false
						other.Interactable = false
					end
				end
				-- Show the Default tagged frame
				child.Visible = true
				child.Interactable = true
				return
			end
		end

		-- If no Default tagged frame found, show No selection
		showActionSection("No selection")
	end

	local function updateSelectionHighlight(selectedButton)
		if not sectionSelect then return end

		-- Get the parent frame of the button (Selection1, Selection2, etc.)
		local selectedFrame = selectedButton.Parent
		local selectedUIStroke = selectedFrame and selectedFrame:FindFirstChild("UIStroke")

		-- Check if this button is already highlighted
		if selectedUIStroke and selectedUIStroke.Enabled then
			-- Deselect: disable the UIStroke and show the Default section
			selectedUIStroke.Enabled = false
			currentSelection = nil
			showDefaultTaggedSection()
			return
		end

		-- Disable all UIStrokes first
		for _, child in sectionSelect:GetChildren() do
			if child:IsA("Frame") then
				local uiStroke = child:FindFirstChild("UIStroke")
				if uiStroke then
					uiStroke.Enabled = false
				end
			end
		end

		-- Enable the selected UIStroke
		if selectedUIStroke then
			selectedUIStroke.Enabled = true
		end

		-- Update current selection and show corresponding section
		-- Use the button's text to find the correct action section (e.g., "Control room", "Core status")
		currentSelection = selectedButton.Text
		showActionSection(currentSelection)
	end

	-- Connect all selection buttons
	if sectionSelect then
		for _, child in sectionSelect:GetChildren() do
			if child:IsA("Frame") then
				local textButton = child:FindFirstChild("TextButton")
				if textButton then
					textButton.Activated:Connect(function()
						playClickSound()
						updateSelectionHighlight(textButton)
					end)
				end
			end
		end
	end

	-- Initialize with default view (No selection visible)
	showActionSection("No selection")

	-- ============================================
	-- 4. Drag functionality for Container and Icon
	-- ============================================
	local function makeDraggable(dragFrame, targetFrame)
		if not dragFrame or not targetFrame then return end

		local dragging = false
		local dragInput
		local dragStart
		local startPos

		local function updatePosition(input)
			if not dragging then return end

			local delta = input.Position - dragStart
			local newPosition = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)

			-- Smooth movement using tween
			local tween = TweenService:Create(targetFrame, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {
				Position = newPosition
			})
			tween:Play()
		end

		-- Mouse input
		dragFrame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = targetFrame.Position

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		dragFrame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
				updatePosition(input)
			end
		end)

		-- Alternative: Use UserInputService for more reliable tracking
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				updatePosition(input)
			end
		end)
	end

	-- Special drag function for Icon with TextButton
	local function makeIconDraggable(iconFrame, textButton)
		if not iconFrame then return end

		local dragging = false
		local dragStart
		local startPos
		local dragStartTime = 0
		local hasDragged = false

		local function updatePosition(input)
			if not dragging then return end

			local delta = input.Position - dragStart

			-- Check if actually dragging (moved more than 5 pixels)
			if not hasDragged and (math.abs(delta.X) > 5 or math.abs(delta.Y) > 5) then
				hasDragged = true
			end

			local newPosition = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)

			-- Smooth movement using tween
			local tween = TweenService:Create(iconFrame, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {
				Position = newPosition
			})
			tween:Play()
		end

		-- Handle drag on the icon frame itself
		iconFrame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = iconFrame.Position
				dragStartTime = tick()
				hasDragged = false

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		iconFrame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				updatePosition(input)
			end
		end)

		-- Use UserInputService for more reliable tracking
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				updatePosition(input)
			end
		end)

		-- Handle TextButton drag - prevent click if dragged
		if textButton then
			textButton.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					dragStart = input.Position
					startPos = iconFrame.Position
					dragStartTime = tick()
					hasDragged = false

					input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							dragging = false
							-- If dragged, don't trigger click
							if hasDragged then
								-- Prevent the Activated event from opening container
								textButton.Interactable = false
								task.wait(0.1)
								textButton.Interactable = true
							end
						end
					end)
				end
			end)

			textButton.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					updatePosition(input)
				end
			end)
		end
	end

	-- Make Container draggable via Drag frame
	local dragFrame = container and container:FindFirstChild("Drag")
	if dragFrame then
		makeDraggable(dragFrame, container)
	end

	-- Make Icon draggable with special handling for TextButton
	if icon then
		local iconTextButton = icon:FindFirstChild("TextButton")
		makeIconDraggable(icon, iconTextButton)
	end

	-- ============================================
	-- 5. Gun menu functionality (Laser gun menu)
	-- ============================================
	local gunMenu = screenGui:FindFirstChild("Laser gun menu")
	local gunIcon = screenGui:FindFirstChild("Gun icon")
	local gunMenuSectionSelect = gunMenu and gunMenu:FindFirstChild("SectionSelect")
	local gunMenuActionSection = gunMenu and gunMenu:FindFirstChild("GunMenu")
	local gunMenuCloseButton = gunMenu and gunMenu:FindFirstChild("GUIname") and gunMenu.GUIname:FindFirstChild("Close button")
	local gunMenuCloseButtonInstance = gunMenuCloseButton and gunMenuCloseButton:FindFirstChild("TextButton")
	local gunMenuDragFrame = gunMenu and gunMenu:FindFirstChild("Drag")

	-- Find the Gun menu master button in Misc section
	local miscSection = actionsection and actionsection:FindFirstChild("Misc")
	local gunMenuMaster = miscSection and miscSection:FindFirstChild("Gun menu master")
	local gunMenuMasterOpen = gunMenuMaster and gunMenuMaster:FindFirstChild("Open")
	local gunMenuMasterOpenButton = gunMenuMasterOpen and gunMenuMasterOpen:FindFirstChild("TextButton")
	local gunMenuMasterOpenValue = gunMenuMasterOpen and gunMenuMasterOpen:FindFirstChild("Open")

	-- Store original sizes and positions for gun menu
	local gunMenuOriginalSize = gunMenu and gunMenu.Size or UDim2.new(0.609561741, 0, 0.808333337, 0)
	local gunMenuOriginalPosition = gunMenu and gunMenu.Position or UDim2.new(0.499168813, 0, 0.5, 0)
	local gunIconOriginalPosition = gunIcon and gunIcon.Position or UDim2.new(0.5, 0, 0.85, 0)
	local gunMenuCollapsed = true
	local gunMenuAnimating = false
	local gunMenuEnabled = false -- Master switch state
	local gunMenuCurrentSelection = nil

	-- Track last positions for restoration
	local gunMenuLastPosition = gunMenuOriginalPosition
	local gunIconLastPosition = gunIconOriginalPosition

	-- Add TextButton to Gun icon if it doesn't exist
	local gunIconTextButton = nil
	if gunIcon then
		gunIconTextButton = gunIcon:FindFirstChild("TextButton")
		if not gunIconTextButton then
			gunIconTextButton = Instance.new("TextButton")
			gunIconTextButton.Name = "TextButton"
			gunIconTextButton.Size = UDim2.new(1, 0, 1, 0)
			gunIconTextButton.Position = UDim2.new(0, 0, 0, 0)
			gunIconTextButton.BackgroundTransparency = 1
			gunIconTextButton.Text = ""
			gunIconTextButton.Parent = gunIcon
		end
	end

	-- Gun menu collapse function
	local function collapseGunMenu()
		if gunMenuCollapsed or not gunMenu or gunMenuAnimating then return end
		gunMenuCollapsed = true
		gunMenuAnimating = true

		-- Save current positions before collapsing
		gunMenuLastPosition = gunMenu.Position
		if gunIcon then
			gunIconLastPosition = gunIcon.Position
		end

		-- Play sound immediately
		playClickSound()

		-- Disable close button immediately to prevent double-clicks
		if gunMenuCloseButtonInstance then
			gunMenuCloseButtonInstance.Interactable = false
		end

		-- Collapse gun menu to 0% size
		local collapseTween = TweenService:Create(gunMenu, tweenInfo, {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		})
		collapseTween:Play()
		collapseTween.Completed:Connect(function()
			-- Hide and disable gun menu when fully collapsed
			gunMenu.Visible = false
			gunMenu.Interactable = false
			gunMenuAnimating = false
		end)

		-- Show gun icon when collapsed at its last position
		if gunIcon then
			gunIcon.Visible = true
			gunIcon.Interactable = true
			gunIcon.Size = UDim2.new(0, 0, 0, 0)
			gunIcon.Position = gunIconLastPosition

			-- Disable gun icon button during animation
			if gunIconTextButton then
				gunIconTextButton.Interactable = false
			end

			local iconTween = TweenService:Create(gunIcon, tweenInfo, {
				Size = UDim2.new(0, 60, 0, 60)
			})
			iconTween:Play()
			iconTween.Completed:Connect(function()
				-- Enable gun icon button after animation completes
				if gunIconTextButton then
					gunIconTextButton.Interactable = true
				end
			end)
		end
	end

	-- Gun menu open function
	local function openGunMenu()
		if not gunMenuCollapsed or not gunMenu or gunMenuAnimating then return end
		gunMenuCollapsed = false
		gunMenuAnimating = true

		-- Play sound immediately
		playClickSound()

		-- Disable gun icon button immediately to prevent double-clicks
		if gunIconTextButton then
			gunIconTextButton.Interactable = false
		end

		-- Set initial size and position for animation (start from collapsed state)
		gunMenu.Size = UDim2.new(0, 0, 0, 0)
		gunMenu.Position = UDim2.new(0.5, 0, 0.5, 0)

		-- Show and enable gun menu before animating
		gunMenu.Visible = true
		gunMenu.Interactable = true

		-- Hide gun icon first
		if gunIcon then
			local iconTween = TweenService:Create(gunIcon, tweenInfo, {
				Size = UDim2.new(0, 0, 0, 0)
			})
			iconTween:Play()
			iconTween.Completed:Connect(function()
				gunIcon.Visible = false
				gunIcon.Interactable = false
				gunIcon.Size = UDim2.new(0, 60, 0, 60)
			end)
		end

		-- Open gun menu back to last saved position
		local openTween = TweenService:Create(gunMenu, tweenInfo, {
			Size = gunMenuOriginalSize,
			Position = gunMenuLastPosition
		})
		openTween:Play()
		openTween.Completed:Connect(function()
			-- Enable close button after animation completes
			if gunMenuCloseButtonInstance then
				gunMenuCloseButtonInstance.Interactable = true
			end
			gunMenuAnimating = false
		end)
	end

	-- Function to update the master switch button text
	local function updateMasterSwitchButtonText()
		playClickSound()
		if gunMenuMasterOpenButton and gunMenuMasterOpenValue then
			gunMenuMasterOpenButton.Text = gunMenuMasterOpenValue.Value and "Open" or "Closed"
		end
	end

	-- Function to update gun menu visibility based on master switch
	local function updateGunMenuVisibility()
		if not gunMenu then return end

		-- Check if master switch is enabled
		local isOpen = gunMenuMasterOpenValue and gunMenuMasterOpenValue.Value or false

		-- Update button text
		updateMasterSwitchButtonText()

		if isOpen then
			-- Master switch is ON - show gun icon
			gunMenuEnabled = true
			if gunIcon then
				gunIcon.Visible = true
				gunIcon.Interactable = true
				gunIcon.Size = UDim2.new(0, 60, 0, 60)
				gunIcon.Position = gunIconLastPosition
			end
			-- Keep gun menu hidden initially
			gunMenu.Visible = false
			gunMenu.Interactable = false
			gunMenuCollapsed = true
		else
			-- Master switch is OFF - hide everything immediately
			gunMenuEnabled = false
			if gunMenu then
				gunMenu.Visible = false
				gunMenu.Interactable = false
				-- Remember position before hiding
				if gunMenu.Size.X.Scale > 0 then
					gunMenuLastPosition = gunMenu.Position
				end
			end
			if gunIcon then
				gunIcon.Visible = false
				gunIcon.Interactable = false
				-- Remember position before hiding
				if gunIcon.Size.X.Offset > 0 then
					gunIconLastPosition = gunIcon.Position
				end
			end
		end
	end

	-- Close button click handler for gun menu
	if gunMenuCloseButtonInstance then
		gunMenuCloseButtonInstance.Activated:Connect(collapseGunMenu)
	end

	-- Gun icon TextButton click handler
	if gunIconTextButton then
		gunIconTextButton.Activated:Connect(openGunMenu)
	end

	-- Keyboard G key handler for gun menu
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.G then
			-- Only work if gun menu is enabled (master switch is ON)
			if not gunMenuEnabled then return end
			-- Same cooldown as clicking the icon - check isAnimating flag
			if gunMenuAnimating then return end
			if gunMenuCollapsed then
				openGunMenu()
