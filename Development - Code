	-- teleportName: Name identifier for the teleport (for debugging)
	-- NOTE: This is a ONE-TIME teleport. For persistent systems (like auto-ore miner),
	-- use enablePriority/disablePriority to lock the priority during the operation.
	local function teleportPlayerToPosition(targetPosition, priority, teleportName)
		-- Default to LOW priority if not specified
		priority = priority or TELEPORT_PRIORITY.LOW
		teleportName = teleportName or "Unnamed Teleport"

		-- Check if this teleport can proceed based on current active priority
		-- If a system has priority enabled (like auto-ore miner), lower priority teleports will be blocked
		if not canTeleport(priority) then
			local blockedBy = _G.WaydroidPriority:getActiveSystem() or "unknown"
			local blockedByPriority = _G.WaydroidPriority:getPriorityName(_G.WaydroidPriority:getActivePriority())
			print("[Teleport] Blocked: " .. teleportName .. " (priority: " .. getPriorityName(priority) .. ") by " .. blockedBy .. " (priority: " .. blockedByPriority .. ")")
			return false
		end

		local character = player.Character
		if not character then return false end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

		if not humanoidRootPart then return false end

		-- Check if player is sitting and make them unsit first
		if humanoid then
			if humanoid.SeatPart then
				-- Player is sitting, make them unsit
				humanoid.Sit = false
				-- Wait a brief moment for the unsit to take effect
