	local function getEnabledCoolantStatePercentage()
		local boolValues = getCoolantStateBoolValues()

		for percentage, boolValue in pairs(boolValues) do
			if boolValue and boolValue:IsA("BoolValue") and boolValue.Value then
				return percentage
			end
		end

		return nil -- No BoolValue is enabled
