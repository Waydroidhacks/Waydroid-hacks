	-- Priority levels: LOW = 1, MEDIUM = 2, HIGH = 3, CRITICAL = 4
	-- Higher priority teleports will block lower priority ones
	local TELEPORT_PRIORITY = {
		LOW = 1,
		MEDIUM = 2,
		HIGH = 3,
		CRITICAL = 4
	}

	-- Teleport manager to track active teleports and their priorities
	local teleportManager = {
		currentPriority = 0, -- 0 means no active teleport
		activeTeleportName = nil,
		locked = false
	}

	-- Function to check if a teleport can proceed based on priority
	local function canTeleport(priority, teleportName)
		-- If no active teleport, allow it
		if teleportManager.currentPriority == 0 then
			return true
		end

		-- If new priority is higher or equal, allow it (higher overrides lower)
		if priority >= teleportManager.currentPriority then
			return true
		end

		-- Lower priority teleport blocked by higher priority
		return false
	end

	-- Function to start a teleport (sets the active priority)
	local function startTeleport(priority, teleportName)
		teleportManager.currentPriority = priority
		teleportManager.activeTeleportName = teleportName
		teleportManager.locked = true
	end

	-- Function to end a teleport (clears the active priority)
	local function endTeleport()
		teleportManager.currentPriority = 0
		teleportManager.activeTeleportName = nil
		teleportManager.locked = false
	end

