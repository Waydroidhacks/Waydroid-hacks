	-- Made global for use across all script segments

	-- Initialize global priority system if not already exists
	if not _G.WaydroidPriority then
		_G.WaydroidPriority = {
			PRIORITY = {
				NONE = 0,
				LOW = 1,
				MEDIUM = 2,
				HIGH = 3,
				CRITICAL = 4
			},
			-- State tracking
			activePriority = 0,      -- Current active priority level (0 = none active)
			activeSystem = nil,      -- Name of system that has priority enabled
			isLocked = false,        -- Whether priority is currently locked

			-- ============================================
			-- TOGGLE FUNCTIONS - Enable/Disable priority
			-- ============================================
			
			-- Enable a priority level (blocks lower priorities from teleporting)
			-- Returns true if successfully enabled, false if blocked by higher priority
			-- Usage: _G.WaydroidPriority.enablePriority(_G.WaydroidPriority.PRIORITY.MEDIUM, "Auto-ore miner")
			enablePriority = function(self, priority, systemName)
				-- If no active priority, allow it
				if self.activePriority == 0 then
					self.activePriority = priority
					self.activeSystem = systemName
					self.isLocked = true
					return true
				end

				-- If new priority is higher or equal, allow it (higher overrides lower)
				if priority >= self.activePriority then
					self.activePriority = priority
					self.activeSystem = systemName
					self.isLocked = true
					return true
				end

				-- Lower priority blocked by higher priority
				return false
			end,

			-- Disable the active priority (allows lower priorities to teleport again)
			-- Usage: _G.WaydroidPriority.disablePriority()
			disablePriority = function(self)
				self.activePriority = 0
				self.activeSystem = nil
				self.isLocked = false
			end,

			-- ============================================
			-- CHECK FUNCTIONS - Query priority state
			-- ============================================

			-- Check if a teleport can proceed based on current active priority
			-- Returns true if allowed, false if blocked by higher priority
			-- Usage: if _G.WaydroidPriority.canTeleport(_G.WaydroidPriority.PRIORITY.LOW) then ...
			canTeleport = function(self, priority)
				-- If no active priority, allow all teleports
				if self.activePriority == 0 then
					return true
				end

				-- If new priority is higher or equal, allow it
				if priority >= self.activePriority then
					return true
				end

				-- Lower priority blocked by higher priority
				return false
			end,

			-- Check if any priority is currently active
			-- Returns true if a system has priority enabled
			isPriorityActive = function(self)
				return self.activePriority > 0
			end,

			-- Get the current active priority level
			getActivePriority = function(self)
				return self.activePriority
			end,

			-- Get the name of the system that has priority enabled
			getActiveSystem = function(self)
				return self.activeSystem
			end,

			-- Check if priority is locked
			isPriorityLocked = function(self)
				return self.isLocked
			end,

			-- ============================================
			-- UTILITY FUNCTIONS
			-- ============================================

			-- Get priority name from value (for debugging/display)
			getPriorityName = function(self, priority)
